# ---- Supabase (marketinsight project) ----
# Create a NEW Supabase project for marketinsight (matches the per-module pattern
# of shopify-inventory-ops / Finance Module). Fill these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. Never expose to the browser. Used by API route handlers / ingestion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for raw line-sheet files (PDF/Excel). Create it in Supabase Storage.
SUPABASE_LINE_SHEETS_BUCKET=line-sheets

# ---- Anthropic (line-sheet extraction) ----
ANTHROPIC_API_KEY=sk-ant-...
# Public, current model id. Sonnet 5 is a strong default for document extraction;
# switch to a higher-tier model if extraction accuracy on messy scanned PDFs matters more than cost.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- FX (landed-cost / margin; used from P2 onward) ----
# Optional daily FX source for converting JPY/EUR/USD wholesale cost -> HKD.
FX_API_URL=
FX_API_KEY=
